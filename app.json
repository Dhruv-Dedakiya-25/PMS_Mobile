{
  "expo": {
    "name": "EstateFlow",
    "slug": "pms-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "estateflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#3B6FF6"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-localization",
      "expo-font",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "cameraPermission": "EstateFlow uses the camera to photograph an issue for a maintenance request.",
          "photosPermission": "EstateFlow opens your photos so you can attach them to a maintenance request.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "icon": "./assets/images/icon.png"
  }
}
